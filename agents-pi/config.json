{
  "$schema": "https://oh-my-pi.org/config.schema.json",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "defaultProvider": "deepseek",
  "defaultThinkingLevel": "medium",
  "description": "Team Pinky - Architecture, Subagents, Rules and Skills for Pi / Oh My Pi (OMP)",
  "models": {
    "fast": "deepseek/deepseek-v4-flash",
    "heavy": "deepseek/deepseek-reasoner",
    "orchestrator": "deepseek/deepseek-v4-flash",
    "smol": "deepseek/deepseek-v4-flash"
  },
  "name": "agents-pi",
  "permissions": {
    "bash": [
      "git *",
      "npm *",
      "bun *",
      "pnpm *",
      "grep *"
    ],
    "edit": [
      "/Volumes/Datos/Projects/**",
      "./**"
    ],
    "read": [
      "/Volumes/Datos/Projects/**",
      "./**"
    ],
    "write": [
      "/Volumes/Datos/Projects/**",
      "./**"
    ]
  },
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible"
    },
    "omlx": {
      "name": "OmlX",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.68.128:8010/v1"
      }
    }
  },
  "theme": "dark",
  "ttsr": {
    "builtinRules": true,
    "enabled": true
  }
}